# Keep local credentials under .carrier/; also exclude common fallback names.
credentials.json
credentials.json.pending
credentials.json.lock
requester.json
requester.json.pending
requester.json.lock
reviewer.json
reviewer.json.pending
reviewer.json.lock
# Build output
/dist/
/build/
*.egg-info/
.ruff_cache/
node_modules/

# Editor temporary files and operating-system metadata
*.swp
*.tmp
.DS_Store
Thumbs.db

# Local secrets; sanitized examples remain reviewable.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# Keep coding-assistant instructions and local configuration out of Git.
